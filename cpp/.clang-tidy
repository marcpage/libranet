# clang-tidy runs every check, to start as strict as possible, less those
# below:
#
# - checks that cannot apply here or cannot be met, and
# - checks the code does not yet meet. These came with the code as it was
#   first written, on 2026-11-13. Each says how many places would need
#   cleaning up, counted on macOS with a header counted once, and shows one
#   of them. Remove a check's lines once its places are clean.
Checks:
  - '*'

  # Cannot apply here, or cannot be met.

  # Advice for FPGA OpenCL kernels.
  - '-altera-*'
  # Rules for LLVM's C library, such as its namespace.
  - '-llvmlibc-*'
  # Contradicts fuchsia-trailing-return.
  - '-modernize-use-trailing-return-type'
  # Contradicts misc-use-anonymous-namespace.
  - '-llvm-prefer-static-over-anonymous-namespace'
  # Names the guard from the file's absolute path, which differs between
  # machines.
  - '-llvm-header-guard'
  # The code uses #pragma once, which every compiler it builds with
  # supports, in place of include guards.
  - '-portability-avoid-pragma-once'
  # Default arguments and overloaded operators are part of the code's
  # design, as in Json, Integer, and Url; Fuchsia's style forbids both.
  - '-fuchsia-default-arguments-calls'
  - '-fuchsia-default-arguments-declarations'
  - '-fuchsia-overloaded-operator'
  # Ask for Abseil's, Boost's, and LLVM's own library functions, none of
  # which the code uses.
  - '-abseil-string-find-str-contains'
  - '-abseil-string-find-startswith'
  - '-boost-use-ranges'
  - '-llvm-use-ranges'
  # Its fix is wrong for Json, whose std::initializer_list constructor
  # takes return {value}; as a one-element array.
  - '-modernize-return-braced-init-list'

  # Not yet met by the code.

  # 7 to clean up (7 in library code, 0 in tests), such as
  # src/http/Headers.hpp:89: 2 adjacent parameters of 'get' of similar type
  # ('std::string_view') are easily swapped by mistake
  #     inline std::string_view Headers::get(std::string_view key, std::s...
  - '-bugprone-easily-swappable-parameters'

  # 4 to clean up (4 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:204: avoid do-while loops
  #     do {
  - '-cppcoreguidelines-avoid-do-while'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/msg/Channel.cpp:15: static objects are disallowed; if possible, use a
  # constexpr constructor instead
  #     std::map<std::string, std::vector<Channel*>> Channel::m_channels;
  - '-fuchsia-statically-constructed-objects'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/types/Json.hpp:208: a trailing return type is disallowed for this
  # function declaration
  #     return std::visit([](auto&& value) -> Type {
  - '-fuchsia-trailing-return'

  # 3 to clean up (3 in library code, 0 in tests), such as
  # src/types/Json.hpp:726: function '_parse_value' is within a recursive call
  # chain
  #     inline Json Json::Parser::_parse_value() {
  - '-misc-no-recursion'

WarningsAsErrors: '*'
# Every header that is not a system header. CMake includes Conan's packages
# as system headers, so their findings are not shown.
HeaderFilterRegex: '.*'
FormatStyle: file
CheckOptions:
  # misc-include-cleaner learns which header provides a POSIX type or macro
  # from the system's own private headers (the macOS SDK's sys/_types/...;
  # on Linux, glibc's bits/... and the kernel's asm/, asm-generic/ and
  # linux/), which differ between systems. So it checks only C++ and project
  # includes, and leaves the POSIX ones as written. It also never suggests a
  # standard library's private headers (libc++'s __chrono/..., libstdc++'s
  # bits/...). POSIX's own calls in a C header, such as gmtime_r() in time.h
  # and fdopen() in stdio.h, are left as written too: C++ code includes those
  # headers as <ctime> and <cstdio>, so they are never asked for.
  misc-include-cleaner.IgnoreHeaders: '__.*;bits/.*;asm/.*\.h$;asm-generic/.*\.h$;linux/.*\.h$;sys/.*\.h$;net/.*\.h$;netinet/.*\.h$;arpa/.*\.h$;netdb\.h$;unistd\.h$;ifaddrs\.h$;fcntl\.h$;stdio\.h$;time\.h$'
  # Json's operator[] checks its own bounds: on a Json that is not const, it
  # grows the array or adds the member, and on a const Json it throws, as
  # at() does. Like std::map's, which the check leaves out by default, it is
  # no unchecked access.
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::types::Json'
  # A private method's name starts with an underscore, as in _parse_value()
  # (Coding Style §4). Only this naming rule is set; the others are kept by
  # hand.
  readability-identifier-naming.PrivateMethodPrefix: '_'
