# clang-tidy runs every check, to start as strict as possible, less those
# below:
#
# - checks that cannot apply here or cannot be met, and
# - checks the code does not yet meet. These came with the code as it was
#   first written, on 2026-11-13. Each says how many places would need
#   cleaning up, counted on macOS with a header counted once, and shows one
#   of them. Remove a check's lines once its places are clean.
Checks:
  - '*'

  # Cannot apply here, or cannot be met.

  # Advice for FPGA OpenCL kernels.
  - '-altera-*'
  # Rules for LLVM's C library, such as its namespace.
  - '-llvmlibc-*'
  # Contradicts fuchsia-trailing-return.
  - '-modernize-use-trailing-return-type'
  # Contradicts misc-use-anonymous-namespace.
  - '-llvm-prefer-static-over-anonymous-namespace'
  # Names the guard from the file's absolute path, which differs between
  # machines. portability-avoid-pragma-once still requires guards.
  - '-llvm-header-guard'

  # Not yet met by the code.

  # 4 to clean up (4 in library code, 0 in tests), such as src/http/Url.hpp:115:
  # use absl::StrContains instead of find() != npos
  #     || allowed_chars.find(character) != std::string_view::npos) {
  - '-abseil-string-find-str-contains'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:234: prefer accept4() to accept() because accept4()
  # allows SOCK_CLOEXEC
  #     fd = ::accept(m_socket_fd, nullptr, nullptr);
  - '-android-cloexec-accept'

  # 4 to clean up (4 in library code, 0 in tests), such as
  # src/http/Headers.hpp:66: use a boost version of this algorithm
  #     return std::lexicographical_compare(
  - '-boost-use-ranges'

  # 7 to clean up (7 in library code, 0 in tests), such as
  # src/http/Headers.hpp:89: 2 adjacent parameters of 'get' of similar type
  # ('std::string_view') are easily swapped by mistake
  #     inline std::string_view Headers::get(std::string_view key, std::s...
  - '-bugprone-easily-swappable-parameters'

  # 28 to clean up (0 in library code, 28 in tests), such as
  # src/http/tests/TestHeaders.cpp:26: unchecked access to optional value
  #     EXPECT_EQ(val.value(), "application/json");
  - '-bugprone-unchecked-optional-access'

  # 2 to clean up (0 in library code, 2 in tests), such as
  # src/types/tests/TestBlockingQueue.cpp:44: 's1' used after it was moved
  #     EXPECT_TRUE(s1.empty()); // moved-from
  - '-bugprone-use-after-move'

  # 6 to clean up (6 in library code, 0 in tests), such as
  # src/net/AddressPosix.cpp:36: do not declare C-style arrays, use 'std::array'
  # instead
  #     char ip_buf[NI_MAXHOST];
  - '-cppcoreguidelines-avoid-c-arrays'
  - '-modernize-avoid-c-arrays'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/types/BlockingQueue.hpp:50: member 'm_capacity' of type 'const size_t'
  # (aka 'const unsigned long') is const qualified
  #     const size_t m_capacity;
  - '-cppcoreguidelines-avoid-const-or-ref-data-members'

  # 4 to clean up (4 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:195: avoid do-while loops
  #     do {
  - '-cppcoreguidelines-avoid-do-while'

  # 12 to clean up (12 in library code, 0 in tests), such as
  # src/http/ResponseCode.hpp:78: constructors that are callable with a single
  # argument must be marked explicit to avoid unintentional implicit conversions
  #     ResponseCode(Status status, std::optional<std::string> custom_rea...
  - '-cppcoreguidelines-explicit-constructor'
  - '-google-explicit-constructor'
  - '-misc-explicit-constructor'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:139: forwarding reference parameter 'socket_call' is
  # never forwarded inside the function body
  #     net::Address query_socket_address(int socket_fd, Func&& socket_call,
  - '-cppcoreguidelines-missing-std-forward'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/msg/AsyncChannel.hpp:22: member variable 'm_logger' has protected
  # visibility
  #     Logger m_logger; // for errors when running asynchronously
  - '-cppcoreguidelines-non-private-member-variables-in-classes'
  - '-misc-non-private-member-variables-in-classes'

  # 11 to clean up (11 in library code, 0 in tests), such as
  # src/net/AddressPosix.cpp:38: do not implicitly decay an array into a
  # pointer; consider using gsl::array_view or an explicit cast instead
  #     ip_buf, sizeof(ip_buf),
  - '-cppcoreguidelines-pro-bounds-array-to-pointer-decay'

  # 125 to clean up (74 in library code, 51 in tests), such as
  # src/http/Headers.hpp:255: possibly unsafe 'operator[]', consider bounds-safe
  # alternatives
  #     return !line.empty() && (line[0] == ' ' || line[0] == '\t');
  - '-cppcoreguidelines-pro-bounds-avoid-unchecked-container-access'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/types/Json.hpp:472: do not use array subscript when the index is not an
  # integer constant expression
  #     out_stream << hex[(code >> nibble_bits) & nibble_mask] << hex[cod...
  - '-cppcoreguidelines-pro-bounds-constant-array-index'

  # 4 to clean up (2 in library code, 2 in tests), such as
  # src/net/SocketPosix.cpp:145: do not use reinterpret_cast
  #     reinterpret_cast<sockaddr*>(&storage), &length);
  - '-cppcoreguidelines-pro-type-reinterpret-cast'

  # 8 to clean up (8 in library code, 0 in tests), such as
  # src/msg/AsyncChannelOf.hpp:12: class 'AsyncChannelOf' defines a non-default
  # destructor but does not define a copy constructor, a copy assignment
  # operator, a move constr...
  #     class AsyncChannelOf : public AsyncChannel {
  - '-cppcoreguidelines-special-member-functions'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:120: enum 'Direction' is unscoped, use 'enum class'
  # instead
  #     enum Direction { DirectionSend,
  - '-cppcoreguidelines-use-enum-class'

  # 109 to clean up (55 in library code, 54 in tests), such as
  # src/http/Headers.hpp:242: calling a function that uses a default argument is
  # disallowed
  #     const auto start = text.find_first_not_of(" \t\r\n");
  - '-fuchsia-default-arguments-calls'

  # 13 to clean up (11 in library code, 2 in tests), such as
  # src/http/ResponseCode.hpp:78: declaring a parameter with a default argument
  # is disallowed
  #     ResponseCode(Status status, std::optional<std::string> custom_rea...
  - '-fuchsia-default-arguments-declarations'

  # 127 to clean up (127 in library code, 0 in tests), such as
  # src/http/Headers.hpp:21: overloading 'operator()' is disallowed
  #     bool operator()(std::string_view lhs, std::string_view rhs) const...
  - '-fuchsia-overloaded-operator'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/msg/Channel.cpp:5: static objects are disallowed; if possible, use a
  # constexpr constructor instead
  #     std::map<std::string, std::vector<Channel*>> Channel::m_channels;
  - '-fuchsia-statically-constructed-objects'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/types/Json.hpp:204: a trailing return type is disallowed for this
  # function declaration
  #     return std::visit([](auto&& value) -> Type {
  - '-fuchsia-trailing-return'

  # 14 to clean up (0 in library code, 14 in tests), such as
  # src/http/tests/TestHeaders.cpp:8: do not use namespace using-directives; use
  # using-declarations instead
  #     using namespace http;
  - '-google-build-using-namespace'

  # 5 to clean up (5 in library code, 0 in tests), such as
  # src/types/Integer.hpp:214: C-style casts are discouraged; use static_cast
  #     while ((high_word & (word_t(1) << (word_bits - 1))) == 0) {
  - '-google-readability-casting'
  - '-modernize-avoid-c-style-cast'

  # 7 to clean up (7 in library code, 0 in tests), such as
  # src/msg/AsyncChannel.cpp:7: anonymous namespace not terminated with a
  # closing comment
  #     }
  - '-google-readability-namespace-comments'
  - '-llvm-namespace-comment'

  # 18 to clean up (12 in library code, 6 in tests), such as
  # src/http/Url.hpp:614: consider replacing 'unsigned long' with 'uint64'
  #     unsigned long p = std::stoul(std::string(str));
  - '-google-runtime-int'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/http/Headers.hpp:289: do not use 'else' after 'break'
  #     } else {
  - '-llvm-else-after-return'
  - '-readability-else-after-return'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/types/Json.hpp:525: 'const auto newline' can be declared as 'const auto
  # *const newline'
  #     const auto newline = pretty ? "\n" : "";
  - '-llvm-qualified-auto'
  - '-readability-qualified-auto'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/msg/Channel.cpp:18: use an LLVM range-based algorithm
  #     auto it = std::find(channelList.begin(), channelList.end(), this);
  - '-llvm-use-ranges'

  # 161 to clean up (30 in library code, 131 in tests), such as
  # src/http/Headers.hpp:80: variable 'it' of type 'const_iterator' (aka
  # '__map_const_iterator<__tree_const_iterator<std::__value_type<std::string,
  # std::string>, __tr...
  #     auto it = m_headers.find(key);
  - '-misc-const-correctness'

  # 72 to clean up (43 in library code, 29 in tests), such as
  # src/msg/AsyncChannel.cpp:6: no header providing "std::string" is directly
  # included
  #     void noop(std::string) {}
  - '-misc-include-cleaner'

  # 5 to clean up (5 in library code, 0 in tests), such as
  # src/types/Integer.hpp:697: function 'operator&' is within a recursive call
  # chain
  #     inline Integer operator&(const Integer& left, const Integer& righ...
  - '-misc-no-recursion'

  # 7 to clean up (0 in library code, 7 in tests), such as
  # src/msg/tests/TestAsyncChannel.cpp:25: function 'wait_until' declared
  # 'static', move to anonymous namespace instead
  #     static bool wait_until(Predicate predicate, std::chrono::millisec...
  - '-misc-use-anonymous-namespace'

  # 3 to clean up (3 in library code, 0 in tests), such as
  # src/types/Integer.hpp:339: use range-based for loop instead
  #     for (std::size_t word_index = 0; word_index < value.size(); ++wor...
  - '-modernize-loop-convert'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/msg/AsyncChannelOf.hpp:16: pass by value and use std::move
  #     AsyncChannelOf(const std::string &name, TypeCallback callback,
  - '-modernize-pass-by-value'

  # 12 to clean up (12 in library code, 0 in tests), such as
  # src/net/Address.hpp:48: avoid repeating the return type from the
  # declaration; use a braced initializer list instead
  #     return Address(std::string(host), port);
  - '-modernize-return-braced-init-list'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/types/Integer.hpp:406: use auto when initializing with a cast to avoid
  # duplicating the type name
  #     unsigned long long unsigned_value = static_cast<unsigned long lon...
  - '-modernize-use-auto'

  # 11 to clean up (11 in library code, 0 in tests), such as
  # src/msg/AsyncChannel.hpp:29: deleted member function should be public
  #     AsyncChannel(const AsyncChannel&) = delete;
  - '-modernize-use-equals-delete'

  # 75 to clean up (75 in library code, 0 in tests), such as
  # src/http/Headers.hpp:32: function 'get' should be marked [[nodiscard]]
  #     std::optional<std::string_view> get(std::string_view key) const n...
  - '-modernize-use-nodiscard'

  # 16 to clean up (5 in library code, 11 in tests), such as
  # src/msg/Channel.cpp:9: use 'std::scoped_lock' instead of 'std::lock_guard'
  #     std::lock_guard lock(m_channel_lock);
  - '-modernize-use-scoped-lock'

  # 3 to clean up (3 in library code, 0 in tests), such as src/http/Url.hpp:22:
  # enum 'EncodeContext' uses a larger base type ('int', size: 4 bytes) than
  # necessary for its value set, consider using 'std::uint8_t' (1 by...
  #     enum class EncodeContext {
  - '-performance-enum-size'

  # 10 to clean up (9 in library code, 1 in tests), such as
  # src/http/Query.hpp:170: 'operator+=' called with a string literal consisting
  # of a single character; consider using the more efficient overload accepting
  # a character
  #     result += "&";
  - '-performance-faster-string-find'
  - '-performance-prefer-single-char-overloads'

  # 2 to clean up (0 in library code, 2 in tests), such as
  # src/types/tests/TestBlockingQueue.cpp:186: 'emplace_back' is called inside a
  # loop; consider pre-allocating the container capacity before the loop
  #     producers.emplace_back([&, p] {
  - '-performance-inefficient-vector-operation'

  # 1 to clean up (1 in library code, 0 in tests), such as src/http/Url.hpp:402:
  # std::move of the const expression has no effect; remove std::move()
  #     url = std::move(parsed_url.value());
  - '-performance-move-const-arg'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/net/AddressPosix.cpp:117: constness of 'ip' prevents automatic move
  #     return ip;
  - '-performance-no-automatic-move'

  # 2 to clean up (2 in library code, 0 in tests), such as src/http/Url.hpp:231:
  # redundant conversion to 'std::string' (aka 'basic_string<char>') and then
  # back to '__self_view' (aka 'basic_string_view<char, std::char_t...
  #     const auto value = m_query.get_first(std::string(key));
  - '-performance-string-view-conversions'

  # 21 to clean up (14 in library code, 7 in tests), such as
  # src/http/Headers.hpp:103: the parameter 'key' of type 'std::string' (aka
  # 'basic_string<char>') is copied for each invocation but only used as a const
  # reference; co...
  #     inline void Headers::remove(std::string key) {
  - '-performance-unnecessary-value-param'

  # 17 to clean up (17 in library code, 0 in tests), such as
  # src/http/Headers.hpp:1: avoid 'pragma once' directive; use include guards
  # instead
  #     #pragma once
  - '-portability-avoid-pragma-once'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/types/Json.hpp:135: parameter 'character' is const-qualified in the
  # function declaration; const-qualification of parameters only has an effect
  # in function de...
  #     static bool is_digit(const char character);
  - '-readability-avoid-const-params-in-decls'

  # 2 to clean up (0 in library code, 2 in tests), such as
  # src/types/tests/TestBlockingQueue.cpp:205: statement should be inside braces
  #     for (auto& t : producers) t.join();
  - '-readability-braces-around-statements'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/http/Request.hpp:165: 'data' should be used for accessing the data
  # pointer instead of taking the address of the 0-th element
  #     in_stream.read(&request.m_body[0], static_cast<std::streamsize>(b...
  - '-readability-container-data-pointer'

  # 2 to clean up (0 in library code, 2 in tests), such as
  # src/types/tests/TestBlockingQueue.cpp:171: function 'TestBody' has cognitive
  # complexity of 26 (threshold 25)
  #     TEST(BlockingQueueTest, MultipleProducersConsumers) {
  - '-readability-function-cognitive-complexity'

  # 106 to clean up (43 in library code, 63 in tests), such as
  # src/http/Headers.hpp:69: parameter name 'c1' is too short, expected at least
  # 3 characters
  #     [](unsigned char c1, unsigned char c2) {
  - '-readability-identifier-length'

  # 17 to clean up (17 in library code, 0 in tests), such as
  # src/http/Url.hpp:114: implicit conversion 'int' -> 'bool'
  #     } else if (std::isalnum(character)
  - '-readability-implicit-bool-conversion'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/types/Json.hpp:136: function 'types::Json::serialize_array' has a
  # definition with different parameter names
  #     static void serialize_array(const Array& arr, std::ostringstream&...
  - '-readability-inconsistent-declaration-parameter-name'

  # 3 to clean up (2 in library code, 1 in tests), such as
  # src/types/Integer.hpp:561: multiple declarations in a single statement
  # reduces readability
  #     std::vector<word_t> quotient, remainder;
  - '-readability-isolate-declaration'

  # 3 to clean up (2 in library code, 1 in tests), such as
  # src/types/Integer.hpp:193: '*' has higher precedence than '+'; add
  # parentheses to explicitly specify the order of operations
  #     carry += static_cast<double_word_t>(left[left_index])
  - '-readability-math-missing-parentheses'

  # 2 to clean up (2 in library code, 0 in tests), such as
  # src/msg/AsyncChannel.cpp:6: all parameters should be named in a function
  #     void noop(std::string) {}
  - '-readability-named-parameter'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/msg/AsyncChannel.cpp:21: redundant empty parameter list in lambda
  # expression
  #     m_thread = std::thread([this]() {
  - '-readability-redundant-lambda-parameter-list'

  # 7 to clean up (3 in library code, 4 in tests), such as
  # src/http/ResponseCode.hpp:74: enum should have a trailing comma
  #     NetworkAuthenticationRequired = 511
  - '-readability-trailing-comma'

  # 3 to clean up (3 in library code, 0 in tests), such as
  # src/net/SocketPosix.cpp:22: preprocessor condition can be written more
  # concisely using '#ifdef'
  #     #if defined(__APPLE__)
  - '-readability-use-concise-preprocessor-directives'

  # 1 to clean up (1 in library code, 0 in tests), such as
  # src/types/Integer.hpp:241: use `std::min` instead of `>`
  #     if (estimated_quotient > max_word) {
  - '-readability-use-std-min-max'

WarningsAsErrors: '*'
# Every header that is not a system header. CMake includes Conan's packages
# as system headers, so their findings are not shown.
HeaderFilterRegex: '.*'
FormatStyle: file
